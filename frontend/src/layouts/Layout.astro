---
import "../styles/site.css";
import appearanceInit from "../scripts/appearance-init.js?raw";
import { themeStyles } from "../lib/theme-styles.js";
const { title = "", description, image, noindex = false, article } = Astro.props;
const site = Astro.locals.site;
const themeConfig = site.theme_config;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.title}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const page = Number(Astro.url.searchParams.get("page"));
if (Number.isInteger(page) && page > 1)
  canonicalUrl.searchParams.set("page", String(page));
const canonical = canonicalUrl.href;
const ogImage = image || site.social_image?.src;
const links = [
  ["/", "HOME"],
  ["/resume/", "RESUME"],
  ["/art/", "ART PORTFOLIO"],
  ["/writing/", "WRITING PORTFOLIO"],
  ["/software/", "SOFTWARE ENGINEERING"],
  ["/blog/", "BLOG"],
  ["/contact/", "CONTACT"],
];
const current = (path) =>
  path === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(path);
const schema = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: article.title,
      datePublished: article.published_at,
            dateModified: article.updated_at,
      mainEntityOfPage: canonical,
      author: { "@type": "Person", name: site.name },
      image: ogImage,
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      name: site.name,
      url: String(Astro.site),
      jobTitle: site.title,
    };
---
<!doctype html>
<html lang="en" data-palette={themeConfig?.default}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description || site.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\u003c")}
    />
    <style is:inline set:html={themeStyles(themeConfig)} />
    <script id="theme-config" type="application/json" is:inline
      set:html={JSON.stringify(themeConfig || null).replace(/</g, "\\u003c")} />
    <script is:inline set:html={appearanceInit} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="topbar">
        <a class="brand" href="/">TF<span>.</span></a>
        <div class="controls">
          <button id="motion-toggle" type="button" aria-pressed="true">Motion on</button
          >
          <button id="tilt-toggle" type="button">Enable tilt</button>
        </div>
      </div>
      <details class="mobile-menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          {
            links.map(([path, label]) => (
              <a href={path} aria-current={current(path) ? "page" : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </details>
      <nav class="desktop-nav" aria-label="Main navigation">
        {
          links.map(([path, label]) => (
            <a href={path} aria-current={current(path) ? "page" : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
      <span id="motion-status" class="sr-only" role="status"></span>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <span>© {new Date().getFullYear()} Thomas Fassih</span>
      <a href="/privacy/">Privacy</a>
      <div class="appearance-controls">
        {themeConfig && (
          <label id="theme-picker" class="theme-picker" hidden>
            Theme
            <select id="theme-select">
              {themeConfig.themes.map(theme => (
                <option value={theme.id} selected={theme.id === themeConfig.default}>{theme.name}</option>
              ))}
            </select>
          </label>
        )}
        <button id="theme-toggle" class="mode-toggle" type="button" role="switch"
          aria-label="Dark mode" aria-checked="false" hidden>
          <svg class="mode-to-dark" width="22" height="22" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
            <path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z" />
          </svg>
          <svg class="mode-to-light" width="22" height="22" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
          </svg>
        </button>
      </div>
    </footer>
    <div id="page-loader" class="page-loader" hidden role="status">
      <span class="spinner" aria-hidden="true"></span><span>Loading page…</span>
    </div>
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
